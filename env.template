# NextAuth.js Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3012
NEXTAUTH_SECRET=your-super-secret-key-here-change-this-in-production

# GitHub OAuth Configuration (Client-Side Only)
# Get these from: https://github.com/settings/developers
# Create a new OAuth App and set Authorization callback URL to: http://localhost:3012/auth/github-callback
# Note: Only NEXT_PUBLIC_GITHUB_CLIENT_ID is needed for client-side OAuth (no secret required)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# Development Settings
NODE_ENV=development

# OpenAI for Whisper transcription (required for /api/transcribe)
# OPENAI_API_KEY=your_openai_api_key_here

