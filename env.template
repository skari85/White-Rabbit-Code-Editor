# NextAuth.js Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3012
NEXTAUTH_SECRET=your-super-secret-key-here-change-this-in-production

# GitHub OAuth Configuration (Optional for now)
# Get these from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Client-side GitHub OAuth (PKCE) for White Rabbit
# Redirect URI defaults to window.location.origin when left blank
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Optional: only set if GitHub app requires a secret for PKCE token exchange.
NEXT_PUBLIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3012
NEXT_PUBLIC_GITHUB_SCOPE=read:user repo

# Development Settings
NODE_ENV=development

# OpenAI for Whisper transcription (required for /api/transcribe)
# OPENAI_API_KEY=your_openai_api_key_here

